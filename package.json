{
  "name": "next-level-editor",
  "version": "1.0.0",
  "description": "A beautiful and feature-rich WYSIWYG editor for Vue.js",
  "author": "André Jordão <andre.cjordao@gmail.com>",
  "license": "MIT",
  "main": "./dist/next-level-editor.umd.js",
  "module": "./dist/next-level-editor.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/next-level-editor.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/next-level-editor.umd.js" },
      "default": "./dist/next-level-editor.mjs"
    },
    "./style.css": "./dist/next-level-editor.css",
    "./dist/next-level-editor.css": "./dist/next-level-editor.css",
    "./locales/en": {
      "import": { "types": "./dist/locales/en.d.mts", "default": "./dist/locales/en.mjs" },
      "require": { "types": "./dist/locales/en.d.cts", "default": "./dist/locales/en.cjs" },
      "default": "./dist/locales/en.mjs"
    },
    "./locales/pt-PT": {
      "import": { "types": "./dist/locales/pt-PT.d.mts", "default": "./dist/locales/pt-PT.mjs" },
      "require": { "types": "./dist/locales/pt-PT.d.cts", "default": "./dist/locales/pt-PT.cjs" },
      "default": "./dist/locales/pt-PT.mjs"
    },
    "./locale": {
      "import": { "types": "./dist/utils/editorLocale.d.mts", "default": "./dist/locales/formatter.mjs" },
      "require": { "types": "./dist/utils/editorLocale.d.cts", "default": "./dist/locales/formatter.cjs" },
      "default": "./dist/locales/formatter.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.locales.config.ts && vue-tsc -p tsconfig.build.json && node scripts/build-declarations.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:devices": "playwright test --config playwright.devices.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "audit:locales": "node scripts/audit-locales.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "prepublishOnly": "vue-tsc --noEmit && npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "wysiwyg",
    "editor",
    "rich-text",
    "contenteditable",
    "text-editor",
    "ckeditor",
    "tinymce",
    "quill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrecj93/Next-Level-Editor.git"
  },
  "bugs": {
    "url": "https://github.com/andrecj93/Next-Level-Editor/issues"
  },
  "homepage": "https://andrecj93.github.io/Next-Level-Editor/",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^27.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.6",
    "@types/prismjs": "^1.26.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^9.18.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.1.0",
    "markdown-it": "^14.1.1",
    "pdfjs-dist": "^5.4.624",
    "postcss": "^8.5.6",
    "prismjs": "^1.30.0",
    "typescript": "^5.3.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.11",
    "vue": "^3.3.8",
    "vue-minimum": "npm:vue@3.3.0",
    "vue-tsc": "^2.1.10",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@cyhnkckali/vue3-color-picker": "^2.1.5",
    "@fontsource/noto-sans": "^5.3.0",
    "diff": "^9.0.0",
    "dompurify": "^3.3.0",
    "fflate": "^0.8.3",
    "html-docx-js-typescript": "^0.1.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "lib0": "^0.2.117",
    "mammoth": "^1.12.3",
    "pdfkit": "^0.20.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.5",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  }
}
