{
  "name": "next-level-editor",
  "version": "1.0.0",
  "description": "A beautiful and feature-rich WYSIWYG editor for Vue.js",
  "main": "./dist/next-level-editor.umd.js",
  "module": "./dist/next-level-editor.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/next-level-editor.es.js",
      "require": "./dist/next-level-editor.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp src/index.d.ts dist/index.d.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "keywords": [
    "vue",
    "vue3",
    "wysiwyg",
    "editor",
    "rich-text",
    "contenteditable",
    "text-editor",
    "ckeditor",
    "tinymce",
    "quill"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrecj93/next-level-editor-jordan.git"
  },
  "bugs": {
    "url": "https://github.com/andrecj93/next-level-editor-jordan/issues"
  },
  "homepage": "https://github.com/andrecj93/next-level-editor-jordan#readme",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue": "^3.3.8",
    "vue-tsc": "^1.8.25"
  }
}
